# Auto-generated by foreman — companion_x
# Copy to .env and fill in values

# --- api base ---
FACTORY_API_HOST=127.0.0.1
FACTORY_API_PORT=8000
# Select Companion-X's project-owned Workflow execution-engine registry.
WORKFLOW_CONFIG_DIR=projects/companion_x/config

# --- dashboard base ---
FACTORY_DASHBOARD_PORT=5001
FACTORY_APP_TITLE="Companion X"

# --- mcp_server base ---
MCP_SERVER_NAME=companion-x
MCP_INCLUDE_BRICKS=
MCP_EXCLUDE_BRICKS=
# Optional: path to a project pyproject.toml; when set, bricks are read from [tool.polylith.bricks] instead of BRICKS_INDEX.yaml
PROJECT_PYPROJECT=

# --- worker base ---
FACTORY_WORKER_BACKEND=memory
FACTORY_CELERY_BROKER_URL=redis://localhost:6379/1

# --- auth ---
# Native MCP auth is required. Local mode is explicit and forces loopback.
# Generate an ephemeral 16..512 character value. Both API and Next server
# processes receive it; the Next BFF never exposes it to browser JavaScript.
MCP_LOCAL_AUTH=true
# Generate a URL-safe token (the launcher does this automatically when blank):
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_LOCAL_AUTH_TOKEN=
MCP_LOCAL_AUTH_SUBJECT=local-operator
MCP_LOCAL_AUTH_ROLES=operator
MCP_AUTH_AUDIENCE=companion-x
MCP_AUTH_REQUIRED_SCOPES=
MCP_PERMISSIONS_CONFIG_DIR=config/mcp_permissions
AUTH_CONFIG_DIR=projects/companion_x/config/auth
FACTORY_AUTH_ADAPTER=memory
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=factory
KEYCLOAK_CLIENT_ID=factory-app
KEYCLOAK_CLIENT_SECRET=change-me

# --- cache ---
FACTORY_CACHE_ADAPTER=memory
REDIS_URL=redis://localhost:6379/0

# --- events ---
FACTORY_EVENTS_ADAPTER=sqlite
EVENTS_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# --- graph ---
FACTORY_GRAPH_ADAPTER=networkx
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- integrations ---
FACTORY_INTEGRATIONS_ADAPTER=rest

# --- kb ---
FACTORY_KB_ADAPTER=chromadb
KB_BACKEND=chromadb
KB_CHROMA_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=18100

# --- aws ---
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# --- llm_gateway ---
FACTORY_LLM_ADAPTER=ollama
FACTORY_LLM_EMBEDDING_ADAPTER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# Companion-X framework-native chat model.
# - openrouter or openrouter/<vendor>/<model> → LangChain ChatOpenAI via OpenRouter
# - ollama/<model>             → LangChain ChatOllama
# - bare model id              → LangChain ChatBedrockConverse
# OpenRouter reasoning display is not part of M0; ordinary streaming and typed
# MCP tool calls still flow through LangGraph → AG-UI → CopilotKit v2.
COMPANION_X_CHAT_MODEL=openrouter
# Durable local session metadata and official LangGraph checkpoints.
COMPANION_X_SESSION_DB_PATH=./.storage/sessions.db
COMPANION_X_CHECKPOINT_DB_PATH=./.storage/agent-checkpoints.db
# Persistent owner-scoped Crew and user-persona configuration.
FACTORY_AGENT_CONFIG_DIR=./.storage/agent-config
# Required when COMPANION_X_CHAT_MODEL=openrouter.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Required only when COMPANION_X_CHAT_MODEL selects OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=2
# Optional OpenRouter attribution headers; neither value is a credential.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Companion-X
# Bedrock Claude-only extended-thinking budget (minimum 1024; ignored by OpenRouter).
COMPANION_X_CHAT_THINKING_BUDGET=16000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- bedrock mantle (OpenAI GPT-5.x via Responses API) ---
# GPT-5.5/5.4 are served ONLY through Bedrock's mantle endpoint (Responses
# API), resolved by strands_adapter._build_mantle_model for any persona whose
# model id starts with "openai.gpt-5" (e.g. the `developer` agent). A fresh
# bearer token is minted per request from the standard AWS credential chain
# (set AWS_PROFILE / AWS creds above) — no API key needed here.
# Region is gated by model availability: gpt-5.5 = us-east-2 ONLY;
# gpt-5.4 = us-east-2 or us-west-2. Independent of AWS_DEFAULT_REGION.
# Requires exact-pinned strands-agents[openai]==1.50.2, which owns the
# openai and token-generator dependencies, plus GPT model access in-region.
# Strands natively resolves /openai/v1 and refreshes the bearer token per request.
BEDROCK_MANTLE_REGION=us-east-2
# Reasoning effort: none|minimal|low|medium|high (AWS recommends >= medium).
BEDROCK_MANTLE_REASONING_EFFORT=medium
# Strands 1.50.2 resolves the native endpoint to /openai/v1. Set the
# optional escape hatch only for a custom full base URL; token refresh remains native.
# BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/openai/v1

# --- memory ---
FACTORY_MEMORY_ADAPTER=amem
MEMORY_BACKEND=amem
AMEM_STORAGE_PATH=./chroma_memory
# Optional A-MEM-only model override. This does not affect chat.
# AMEM_LLM_MODEL=us.amazon.nova-2-lite-v1:0
MEMORY_EMBEDDINGS=
ZEP_API_KEY=

# --- notification ---
FACTORY_NOTIFICATION_ADAPTER=stdio

# --- security ---
FACTORY_SECURITY_ADAPTER=mock

# --- storage ---
FACTORY_STORAGE_ADAPTER=memory
STORAGE_DOC_BACKEND=sqlite
STORAGE_GRAPH_BACKEND=networkx
POSTGRES_DSN=postgresql://factory:factory@localhost:5432/factory
AWS_S3_BUCKET=factory-storage

# --- telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
OTEL_SERVICE_NAME=factory

# --- workflow ---
FACTORY_WORKFLOW_ADAPTER=memory
DAGSTER_HOME=/opt/dagster/dagster_home

# --- strands context offloader ---
STRANDS_OFFLOAD_BACKEND=file
STRANDS_OFFLOAD_DIR=./.storage/offloaded
STRANDS_OFFLOAD_MAX_TOKENS=8000
STRANDS_OFFLOAD_PREVIEW_TOKENS=2500

# --- chat agent ---
# One trusted adapter bundle drives agent, chat, graph, and coordination.
AGENT_RUNTIME_CONFIG=projects/companion_x/config/agent-runtime.yaml

# --- chat streaming (current LangGraph astream → normalized AG-UI events) ---
CHAT_STREAMING=on

# --- shell / python_repl headless consent (bd:python-factory-wog0b) ---
# The HITL gate for shell + python_repl is ShellApprovalPlugin (the FE
# Approve/Deny card), NOT the strands_tools CLI consent prompt. On a headless
# API process the SDK's stdin prompt ("Do you want to proceed? [y/*]") has no
# TTY and DEADLOCKS the async SSE stream. Disable both consent paths so the
# plugin is the single source of truth:
#   STRANDS_NON_INTERACTIVE -> shell.py: kills consent + console UI + PTY stdin-watch
#   BYPASS_TOOL_CONSENT     -> python_repl.py: the ONLY var python_repl honors
STRANDS_NON_INTERACTIVE=true
BYPASS_TOOL_CONSENT=true

# Canonical in-process OpenTelemetry provenance exporter
TELEMETRY_CONFIG_DIR=projects/companion_x/telemetry
TELEMETRY_REQUIRED=1